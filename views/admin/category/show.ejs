<!-- views/admin/category/show.ejs -->
<%
    const features = category.features || [];
    const applications = category.applications || [];
    const faqs = category.faqs || [];
    const productList = products || [];
%>

<!-- Header -->
<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded bg-light border d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                <i class="bi <%= category.icon || 'bi-tag' %>" style="font-size:24px;"></i>
            </div>
            <div>
                <h4 class="mb-1"><%= category.name %></h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <% if (category.is_active) { %>
                        <span class="badge bg-success">Active</span>
                    <% } else { %>
                        <span class="badge bg-danger">Inactive</span>
                    <% } %>
                </div>
            </div>
        </div>
        <div>
            <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-sm btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row mb-3">
    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 pt-3">
                <div class="rounded bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                    <i class="bi bi-lightning-charge fs-5"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">Features</span>
                    <h5 class="mb-0"><%= features.length %></h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 pt-3">
                <div class="rounded bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                    <i class="bi bi-diagram-3 fs-5"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">Applications</span>
                    <h5 class="mb-0"><%= applications.length %></h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 pt-3">
                <div class="rounded bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                    <i class="bi bi-chat-left-text fs-5"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">FAQs</span>
                    <h5 class="mb-0"><%= faqs.length %></h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-2">
        <div class="card">
            <div class="card-body d-flex align-items-center gap-3 pt-3">
                <div class="rounded bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
                    <i class="bi bi-box-seam fs-5"></i>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1">Products</span>
                    <h5 class="mb-0"><%= productList.length %></h5>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Tabs -->
<div class="card">
    <div class="card-body">
        <ul class="nav nav-tabs nav-tabs-bordered" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-overview-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-overview" type="button" role="tab" aria-controls="tab-overview"
                    aria-selected="true">Overview</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-features-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-features" type="button" role="tab" aria-controls="tab-features"
                    aria-selected="false">Features (<%= features.length %>)</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-applications-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-applications" type="button" role="tab" aria-controls="tab-applications"
                    aria-selected="false">Applications (<%= applications.length %>)</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-faqs-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-faqs" type="button" role="tab" aria-controls="tab-faqs"
                    aria-selected="false">FAQs (<%= faqs.length %>)</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-products-btn" data-bs-toggle="tab"
                    data-bs-target="#tab-products" type="button" role="tab" aria-controls="tab-products"
                    aria-selected="false">Products (<%= productList.length %>)</button>
            </li>
        </ul>

        <div class="tab-content pt-3">
            <!-- Overview -->
            <div class="tab-pane fade show active" id="tab-overview" role="tabpanel"
                aria-labelledby="tab-overview-btn">
                <div class="row">
                    <div class="col-lg-7 mb-3">
                        <h6 class="text-muted mb-2">Description</h6>
                        <% if (category.description) { %>
                            <div style="white-space: pre-wrap;"><%- category.description %></div>
                        <% } else { %>
                            <p class="text-muted fst-italic mb-0">No description added yet.</p>
                        <% } %>
                    </div>
                    <div class="col-lg-5 mb-3">
                        <h6 class="text-muted mb-2">Details</h6>
                        <table class="table table-borderless table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th class="text-muted" style="width:150px;">Slug</th>
                                    <td><code><%= category.slug %></code></td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Icon</th>
                                    <td>
                                        <i class="bi <%= category.icon || 'bi-tag' %> me-1"></i>
                                        <code><%= category.icon || 'bi-tag' %></code>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Status</th>
                                    <td>
                                        <% if (category.is_active) { %>
                                            <span class="badge bg-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Inactive</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Meta Title</th>
                                    <td><%= category.meta_title || '—' %></td>
                                </tr>
                                <tr>
                                    <th class="text-muted">Meta Description</th>
                                    <td><%= category.meta_description || '—' %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- Features -->
            <div class="tab-pane fade" id="tab-features" role="tabpanel" aria-labelledby="tab-features-btn">
                <% if (features.length) { %>
                    <div class="row">
                        <% features.forEach(feature => { %>
                            <div class="col-md-6 col-xl-4 mb-3">
                                <div class="border rounded p-3 h-100">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                            <i class="bi <%= feature.icon || 'bi-check-circle' %>"></i>
                                        </div>
                                        <strong><%= feature.title %></strong>
                                    </div>
                                    <% if (feature.description) { %>
                                        <div class="text-muted small" style="white-space: pre-wrap;"><%- feature.description %></div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-lightning-charge d-block mb-2" style="font-size:32px;"></i>
                        <p class="mb-2">No features added for this category yet.</p>
                        <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add Features
                        </a>
                    </div>
                <% } %>
            </div>
            <!-- Applications -->
            <div class="tab-pane fade" id="tab-applications" role="tabpanel" aria-labelledby="tab-applications-btn">
                <% if (applications.length) { %>
                    <div class="row">
                        <% applications.forEach(application => { %>
                            <div class="col-md-6 col-xl-4 mb-3">
                                <div class="border rounded p-3 h-100">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                            <i class="bi <%= application.icon || 'bi-grid' %>"></i>
                                        </div>
                                        <strong><%= application.title %></strong>
                                    </div>
                                    <% if (application.description) { %>
                                        <div class="text-muted small" style="white-space: pre-wrap;"><%- application.description %></div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-diagram-3 d-block mb-2" style="font-size:32px;"></i>
                        <p class="mb-2">No applications added for this category yet.</p>
                        <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add Applications
                        </a>
                    </div>
                <% } %>
            </div>
            <!-- FAQs -->
            <div class="tab-pane fade" id="tab-faqs" role="tabpanel" aria-labelledby="tab-faqs-btn">
                <% if (faqs.length) { %>
                    <div class="accordion" id="categoryFaqsAccordion">
                        <% faqs.forEach((faq, index) => { %>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button <%= index === 0 ? '' : 'collapsed' %>" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#category-faq-<%= index %>"
                                        aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
                                        <%= faq.question %>
                                    </button>
                                </h2>
                                <div id="category-faq-<%= index %>"
                                    class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>"
                                    data-bs-parent="#categoryFaqsAccordion">
                                    <div class="accordion-body" style="white-space: pre-wrap;"><%- faq.answer %></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-chat-left-text d-block mb-2" style="font-size:32px;"></i>
                        <p class="mb-2">No FAQs added for this category yet.</p>
                        <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add FAQs
                        </a>
                    </div>
                <% } %>
            </div>
            <!-- Products -->
            <div class="tab-pane fade" id="tab-products" role="tabpanel" aria-labelledby="tab-products-btn">
                <% if (productList.length) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-center">Stock</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% productList.forEach(product => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <% const thumb = product.image || (product.images && product.images[0]) || ''; %>
                                                <% if (thumb) { %>
                                                    <img src="<%= thumb %>" alt="<%= product.name %>" class="rounded"
                                                        style="width:40px;height:40px;object-fit:cover;">
                                                <% } else { %>
                                                    <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                                        style="width:40px;height:40px;">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                <% } %>
                                                <a href="/admin/products/<%= product.id %>"
                                                    class="fw-semibold text-decoration-none"><%= product.name %></a>
                                            </div>
                                        </td>
                                        <td class="text-end">Rs <%= Number(product.price).toLocaleString() %></td>
                                        <td class="text-center">
                                            <% if (product.stock > 0) { %>
                                                <span class="badge bg-success"><%= product.stock %> in stock</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Out of stock</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <a href="/admin/products/<%= product.id %>"
                                                class="btn btn-sm btn-outline-primary" title="View product">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-box-seam d-block mb-2" style="font-size:32px;"></i>
                        <p class="mb-2">No products in this category yet.</p>
                        <a href="/admin/products/new" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add Product
                        </a>
                    </div>
                <% } %>
            </div>




        </div>
    </div>
</div>

